# Copiez ce fichier en .env.local et remplissez les valeurs (voir README).
# Sans aucune valeur, le site tourne en mode démo.

# URL publique du site, sans slash final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Développeurs → Clés API / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (e-mails)
RESEND_API_KEY=
EMAIL_FROM="Super Papa de Flora <onboarding@resend.dev>"

# Protection de l'admin (fortement recommandé en production)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Secret des tâches planifiées Vercel
CRON_SECRET=
